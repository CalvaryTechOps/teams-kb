# --- App ---
# Public base URL of this deployment (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Product name shown in the tab title, breadcrumbs, sign-in page and sidebar
# wordmark. Default: "Knowledge base".
NEXT_PUBLIC_APP_TITLE=
# Credit line at the bottom of the sign-in page. Default: "Built by Calvary
# Tech Ops". Set to an empty value (NEXT_PUBLIC_BUILT_BY=) to hide it.
# NEXT_PUBLIC_BUILT_BY=
# Optional logo for the sidebar and sign-in page (absolute URL, shown on a dark
# background). Leave blank to render the app title as a text wordmark.
NEXT_PUBLIC_LOGO_URL=

# --- Neon Postgres ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string, used by drizzle-kit for migrations.
# The Neon Vercel integration sets both; locally you can copy them with
# `vercel env pull .env.local` to point at the Neon development branch.
DATABASE_URL_UNPOOLED=

# --- Entra ID SAML SSO (Enterprise application) ---
# "Login URL" from the enterprise app's SAML config.
SAML_ENTRY_POINT=
# "Microsoft Entra Identifier", e.g. https://sts.windows.net/<tenant-id>/
SAML_IDP_ENTITY_ID=
# Base64 signing certificate downloaded from the enterprise app ("Certificate
# (Base64)"). Paste as ONE line including the BEGIN/END CERTIFICATE markers,
# with the newlines simply removed — do NOT use literal \n escape sequences
# (dotenv leaves them as backslash-n in unquoted values, which breaks
# signature validation with ERROR_UNMATCH_CERTIFICATE_DECLARATION_IN_METADATA).
SAML_IDP_CERT=
# Staff email domain, used to route SSO sign-in (required for SSO to be enabled).
SAML_EMAIL_DOMAIN=example.com

# --- Microsoft Graph sync (App registration; used starting in M2) ---
GRAPH_TENANT_ID=
# The "Application (client) ID" from the app registration's Overview page —
# NOT the "Object ID" next to it (that causes AADSTS700016 at token request).
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Admin bootstrap ---
# Entra object id of the M365 group whose members are always KB admins.
KB_BOOTSTRAP_ADMIN_GROUP_ID=

# --- Vercel Blob (guide image uploads; used starting in M4) ---
# Read-write token from the Blob store (Vercel dashboard → Storage → your
# store → the ".env.local" / tokens snippet). Store must be PUBLIC access —
# guide pages link images directly, so readers fetch them without a token.
# Uploads return a clear 503 until this is set.
BLOB_READ_WRITE_TOKEN=

# --- MCP (AI agents; see plans/mcp-server.md and README "Connecting an AI agent") ---
# Let agents register themselves (RFC 7591 dynamic client registration) —
# needed by clients that predate MCP 2026-07-28 Client ID Metadata Documents.
# Default true; set to false once Admin → MCP shows no dynamically registered
# clients. Registration is rate-limited and grants nothing by itself: every
# token still needs a staff member to sign in and approve.
# MCP_ALLOW_DYNAMIC_CLIENT_REGISTRATION=true
# Optional override of the MCP resource identifier that tokens are bound to.
# Default: ${NEXT_PUBLIC_APP_URL}/api/mcp. Must be HTTPS except on localhost.
# MCP_RESOURCE_URL=

# --- Cron ---
# Shared secret required by /api/cron/graph-sync (set the same value in Vercel).
CRON_SECRET=
